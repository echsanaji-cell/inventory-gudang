# Database Supabase (Settings → Database → Connection String di dashboard Supabase)
DATABASE_URL=

# Flask secret key untuk session — generate dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Kredensial Gmail untuk kirim notifikasi (pakai App Password, bukan password akun biasa)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=

# Google Sheets sync (Service Account JSON credential + ID spreadsheet tujuan)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=

# Secret untuk endpoint cron job terjadwal (cek stok kritis, backup otomatis)
CRON_SECRET=

# Otomatis diset TRUE oleh platform Render — JANGAN diisi manual untuk lokal
RENDER=